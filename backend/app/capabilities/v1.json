{
  "version": "fullstack-v1.0.0",
  "quality": "三档对照样例尚未人工核验；不是可发放题库。完整目录不代表所有语言、框架或模型已实测可用。",
  "difficulty_criteria": {
    "基础": "读懂已给材料，作局部判断并指出直接证据。",
    "进阶": "对照多条线索区分可能原因，说明反例或下一项验证。",
    "综合": "跨模块同时考虑效果、风险和代价，给出失败恢复与验证；只对明确考察且单独评分的能力取证。"
  },
  "backgrounds": [
    {
      "id": "requirements-evidence-v1",
      "name": "业务规则与事件表",
      "boundary": "仅针对题目明确给出的参与者、触发条件和约束；不推断真实公司的需求。"
    },
    {
      "id": "systems-evidence-v1",
      "name": "伪代码、资源与构建日志",
      "boundary": "判断只使用给定伪代码语义和进程/线程模型；不自动认证某语言、编译器或操作系统。"
    },
    {
      "id": "frontend-evidence-v1",
      "name": "浏览器表单与异步事件",
      "boundary": "适用给定 DOM、焦点和事件时序；React/Vue 等框架的具体行为需单独背景证据。"
    },
    {
      "id": "network-evidence-v1",
      "name": "DNS、TLS、HTTP 与代理记录",
      "boundary": "适用题目给出的协议记录和浏览器限制；不凭服务器端成功推断浏览器跨域可用。"
    },
    {
      "id": "api-evidence-v1",
      "name": "HTTP 服务契约与事务时序",
      "boundary": "仅验证接口/业务边界判断；FastAPI、Flask、Spring 的中间件与事务语义须分别取证。"
    },
    {
      "id": "data-evidence-v1",
      "name": "关系约束、SQL 与事务日志",
      "boundary": "适用给定关系数据库隔离级别与执行计划；不同数据库版本/锁语义不能互认。"
    },
    {
      "id": "async-evidence-v1",
      "name": "缓存读写及消息交付时序",
      "boundary": "只使用题面声明的 TTL、投递保证和顺序规则；不将某中间件名称当恰好一次保证。"
    },
    {
      "id": "testing-evidence-v1",
      "name": "需求、测试记录与故障注入",
      "boundary": "判断测试证据是否支持给定要求；合成测试不代替真实供应商质量或生产容量。"
    },
    {
      "id": "performance-evidence-v1",
      "name": "耗时分段、负载和资源指标",
      "boundary": "只对给定硬件、负载、采样窗口与并发模型成立；平均值不能代表尾延迟。"
    },
    {
      "id": "security-evidence-v1",
      "name": "多租户请求、输入与秘密流向",
      "boundary": "适用给定身份/信任边界；示例不能证明所有攻击已覆盖，不能外发真实秘密。"
    },
    {
      "id": "operations-evidence-v1",
      "name": "容器、流水线、探针与备份记录",
      "boundary": "Docker/CI/CD/Kubernetes 只在给定配置与日志范围内判断；未经演练不宣称生产或灾备可用。"
    },
    {
      "id": "architecture-evidence-v1",
      "name": "模块关系、接口版本和故障域",
      "boundary": "仅对题目给出的规模、团队约束与迁移成本比较；不默认微服务优于单体。"
    },
    {
      "id": "ai-evidence-v1",
      "name": "检索片段、模型回答与工具请求",
      "boundary": "只核对给定检索证据和调用权限；连通成功不证明模型评分、检索召回或所有框架兼容。"
    },
    {
      "id": "team-evidence-v1",
      "name": "需求、Git 差异、审查和交接记录",
      "boundary": "只评价可检查的协作产物，不把 AI 总结或站内称号当个人生产经验。"
    }
  ],
  "domains": [
