          "criterion": "引用目标和成本证据，说明受益者、冲突规则与取舍，不把未经证实的收益当事实。",
          "background_id": "requirements-evidence-v1",
          "levels": [
            {
              "difficulty": "基础",
              "required": [],
              "alternatives": []
            },
            {
              "difficulty": "进阶",
              "required": [
                {
                  "capability_id": "requirements.tradeoff",
                  "difficulty": "基础",
                  "background_id": "requirements-evidence-v1"
                }
              ],
              "alternatives": []
            },
            {
              "difficulty": "综合",
              "required": [
                {
                  "capability_id": "requirements.tradeoff",
                  "difficulty": "进阶",
                  "background_id": "requirements-evidence-v1"
                }
              ],
              "alternatives": []
            }
          ]
        }
      ],
      "examples": [
        {
          "difficulty": "基础",
          "capability_ids": [
            "requirements.acceptance"
          ],
          "task": "订单支付后应发货；支付失败不应发货，哪个事件允许进入发货？",
          "acceptable": "引用支付成功事件及失败分支，选择成功后才发货。",
          "insufficient": "仅说用户点了支付就发货。"
        },
        {
          "difficulty": "进阶",
          "capability_ids": [
            "requirements.acceptance",
            "requirements.tradeoff"
          ],
          "task": "营销要求立即发券，风控要求审核后发券；日志有待审核、拒绝与通过三态。",
          "acceptable": "区分三态并要求确认营销时效与风控约束的优先级；列出验收结果。",
          "insufficient": "只实现营销文案而忽略拒绝状态。"
        },
        {
          "difficulty": "综合",
          "capability_ids": [
            "requirements.acceptance",
            "requirements.tradeoff"
          ],
          "task": "即时退款可减少投诉，但外部结算隔日确认；比较先承诺与待确认两方案。",
          "acceptable": "区分可撤销申请与不可逆资金动作，给出时效、对账失败和补偿验证。",
          "insufficient": "用平均满意度覆盖重复退款风险。"
        }
      ]
    },
